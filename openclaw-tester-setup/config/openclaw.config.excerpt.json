{
  "agents": {
    "entries": {
      "tester": {
        "name": "Tester",
        "workspace": "/home/abs-bot-01/.openclaw/workspace/tester",
        "agentDir": "/home/abs-bot-01/.openclaw/agents/tester/agent",
        "model": {
          "primary": "openrouter/@preset/abs-medium",
          "fallbacks": [
            "openrouter/@preset/abs-small"
          ]
        },
        "identity": {
          "name": "Tester",
          "emoji": "\ud83e\uddea",
          "theme": "calm, methodical QA partner"
        },
        "description": "A conversational, evidence-first human-style QA partner for safe exploratory and regression testing.",
        "thinkingDefault": "high",
        "verboseDefault": "off",
        "toolProgressDetail": "explain",
        "contextInjection": "always",
        "tools": {
          "profile": "minimal",
          "alsoAllow": [
            "browser",
            "computer",
            "read",
            "write",
            "edit",
            "exec",
            "process",
            "message",
            "ask_user",
            "view_image",
            "file_fetch",
            "dir_list",
            "memory_search",
            "memory_get"
          ],
          "fs": {
            "workspaceOnly": true
          },
          "exec": {
            "host": "gateway",
            "mode": "allowlist",
            "pathPrepend": [
              "/home/abs-bot-01/.openclaw/tester-workspace/bin"
            ],
            "timeoutSeconds": 120,
            "strictInlineEval": true
          }
        },
        "memory": {
          "search": {
            "enabled": true,
            "rememberAcrossConversations": false,
            "sources": [
              "memory"
            ],
            "extraPaths": [
              {
                "path": "tester-data/knowledge.md"
              },
              {
                "path": "tester-data/index.md"
              }
            ],
            "provider": "none",
            "query": {
              "maxResults": 8,
              "minScore": 0.15
            }
          }
        }
      }
    }
  },
  "gateway": {
    "auth": {
      "mode": "none"
    },
    "bind": "loopback",
    "port": 18789,
    "mode": "local"
  },
  "plugins": {
    "entries": {
      "cua-computer": {
        "enabled": true
      }
    }
  }
}