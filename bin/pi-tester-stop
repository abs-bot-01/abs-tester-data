#!/bin/sh
# Stop an application started by the caller's pi-tester-launch session.
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
. "$ROOT/bin/pi-tester-runtime"
if [ "$#" -ne 1 ]; then
  echo "usage: pi-tester-stop <app-id>" >&2
  exit 2
fi
case "$1" in
  pi-tester-app-[A-Za-z0-9-]*) : ;;
  *) echo "invalid app id" >&2; exit 3 ;;
esac
runtime=$(pi_tester_prepare_runtime)
pid_file="$runtime/apps/$1.pid"
if [ -f "$pid_file" ]; then
  pid=$(head -n 1 -- "$pid_file")
  case "$pid" in *[!0-9]*|'') echo "invalid pid file" >&2; exit 4 ;; esac
  kill "$pid" 2>/dev/null || true
  rm -f -- "$pid_file"
fi
printf '{"stopped":"%s","runtime":"%s"}\n' "$1" "$runtime"
