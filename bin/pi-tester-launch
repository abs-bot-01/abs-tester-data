#!/bin/sh
# Launch a supplied desktop application on the caller's Pi-agent display.
set -eu
if [ "$#" -lt 1 ]; then
  echo "usage: pi-tester-launch <executable-or-command> [args...]" >&2
  exit 2
fi
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
. "$ROOT/bin/pi-tester-runtime"
runtime=$(pi_tester_prepare_runtime)
DISPLAY_NAME=$(pi_tester_resolve_display)
AUTH_FILE=$(pi_tester_auth_file)

if ! DISPLAY="$DISPLAY_NAME" XAUTHORITY="$AUTH_FILE" /usr/bin/xdpyinfo >/dev/null 2>&1; then
  echo "display $DISPLAY_NAME is not available or is not authorized; run bin/pi-tester-display first" >&2
  exit 3
fi

requested_app=$1
app=$requested_app
shift
case "$app" in
  */*) app=$(realpath -- "$app") ;;
  *) app=$(command -v -- "$app" 2>/dev/null || true)
     [ -n "$app" ] || { echo "app not found in PATH: $requested_app" >&2; exit 4; }
     app=$(realpath -- "$app") ;;
esac
[ -f "$app" ] && [ -x "$app" ] || { echo "app is not an executable file: $app" >&2; exit 5; }

app_id="pi-tester-app-$(date +%s)-$$"
pid_file="$runtime/apps/$app_id.pid"
log_file="$runtime/apps/$app_id.log"
(
  export DISPLAY="$DISPLAY_NAME"
  export XAUTHORITY="$AUTH_FILE"
  export XDG_SESSION_TYPE=x11
  export NO_AT_BRIDGE=0
  export QT_QPA_PLATFORM=xcb
  export GDK_BACKEND=x11
  export QT_ACCESSIBILITY=1
  exec "$app" "$@"
) >"$log_file" 2>&1 &
pid=$!
printf '%s\n' "$pid" >"$pid_file"
chmod 600 -- "$pid_file" "$log_file"
printf '{"app_id":"%s","pid":%s,"app":"%s","display":"%s","runtime":"%s","log":"%s"}\n' \
  "$app_id" "$pid" "$app" "$DISPLAY_NAME" "$runtime" "$log_file"
